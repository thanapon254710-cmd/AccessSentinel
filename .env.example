# Copy to `.env` (git-ignored) and replace every `change-me` value.
# Generate strong values, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(24))"

# --- Docker Compose (lets `docker compose ...` run from the repository root) ---
COMPOSE_FILE=deploy/docker-compose.yml
COMPOSE_PROJECT_NAME=accesssentinel

# --- Runtime -------------------------------------------------------------------
AS_ENVIRONMENT=dev
AS_LOG_LEVEL=INFO

# --- Kafka (host view; containers use kafka:29092, set in docker-compose.yml) ---
AS_KAFKA_BOOTSTRAP=localhost:9092
AS_KAFKA_TOPIC_PREFIX=
AS_KAFKA_PARTITIONS=8
AS_KAFKA_REPLICATION=1

# --- HDFS / WebHDFS (host view; containers use http://namenode:9870) -----------
AS_HDFS_URL=http://localhost:9870
AS_HDFS_USER=root
AS_HDFS_BASE=/accesssentinel

# --- PostgreSQL ------------------------------------------------------------------
AS_POSTGRES_HOST=localhost
AS_POSTGRES_PORT=5432
AS_POSTGRES_DB=accesssentinel
AS_POSTGRES_USER=accesssentinel
AS_POSTGRES_PASSWORD=change-me

# --- Redis -------------------------------------------------------------------------
AS_REDIS_HOST=localhost
AS_REDIS_PORT=6379
AS_REDIS_PASSWORD=change-me

# --- Gateway and demo applications ----------------------------------------------
# Shared secret the gateway sends to the protected apps (>= 24 random characters).
AS_UPSTREAM_TOKEN=change-me
# Secret for service-to-gateway calls (session revocation).
AS_INTERNAL_TOKEN=change-me
# Set to true when the gateway is served over HTTPS.
AS_COOKIE_SECURE=false
# Password of the 10 demo users created by db-init (refused when AS_ENVIRONMENT=prod).
AS_DEMO_USER_PASSWORD=change-me
# Password of the dashboard accounts analyst1 (security_analyst) and secadmin (security_admin).
AS_ANALYST_PASSWORD=change-me
