# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Local runtime data (created by HistoricalStore and the demo)
accesssentinel_data/
*.jsonl
*.parquet

# Trained models and large artifacts
*.pt
*.pth
*.ckpt

# Secrets and local config
.env
.env.*
!.env.example

# Logs from your own runs
*.log
!demo_output_example.log

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
# Trained models: the PROMOTED versions are tracked (about 2.5 MB) so a fresh clone runs without training.
# Other versions (retraining candidates, experiments) stay local unless added on purpose.
models/*/*
!models/*/CURRENT
!models/tcn/tcn-20261110T194520Z-beeb9b/
!models/tgn/tgn-20261111T104626Z-ccc61d/
!models/**/model.pt

# Shareable archives made with git archive
*.zip
