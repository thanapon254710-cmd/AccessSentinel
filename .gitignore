# Python
__pycache__/
*.py[cod]
.venv/
.venv-gpu/
venv/
.pytest_cache/
*.egg-info/

# Local runtime data (created by HistoricalStore and the demo)
accesssentinel_data/
*.jsonl
*.parquet

# Trained models and large artifacts
*.pt
*.pth
*.ckpt

# Secrets and local config
.env
.env.*
!.env.example

# Logs from your own runs
*.log
!demo_output_example.log

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
# Trained models: the PROMOTED versions are tracked so a fresh clone runs without training. CURRENT points at the
# v3 models, so their folders must be tracked too (they were not: a fresh clone pointed at missing models and had to
# retrain). The D3 models stay tracked as the D3 baseline. Other versions stay local unless added on purpose.
models/*/*
!models/*/CURRENT
!models/tcn/tcn-20261110T194520Z-beeb9b/
!models/tgn/tgn-20261111T104626Z-ccc61d/
!models/tcn/tcn3-20261115T091825Z-0c7a4e/
!models/tgn/tgn3-20261115T094228Z-ccc61d/
!models/**/model.pt

# Shareable archives made with git archive
*.zip
